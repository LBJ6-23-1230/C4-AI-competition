# 知学 Mate · 后端环境变量模板
#
# 复制为 .env 后填写真实 Key：Copy-Item .env.example .env
# .env 已在 .gitignore 中，绝不入库、绝不提交到比赛压缩包。

# ---- 通义千问 / DashScope ----
# 不填也能跑：聊天层自动降级为确定性规则，并在回复里明确标注"非大模型输出"，
# 不会伪装成真实 AI 结果。填上之后「错题拍照 → Qwen-VL 真实识别」链路立即生效。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-vl-plus

# ---- 备选：DeepSeek（同样是 OpenAI 兼容协议）----
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---- 服务端口 ----
PORT=5000
