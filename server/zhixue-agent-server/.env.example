# 知学 Mate · 后端环境变量模板
#
# 复制为 .env 后填写真实 Key：Copy-Item .env.example .env
# .env 已在 .gitignore 中，绝不入库、绝不提交到比赛压缩包。

# ---- 通义千问 / DashScope ----
# 不填也能跑：聊天层自动降级为确定性规则，并在回复里明确标注"非大模型输出"，
# 不会伪装成真实 AI 结果。填上之后「错题拍照 → Qwen-VL 真实识别」链路立即生效。
# DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 自然语言层：文本意图/回复与图片识别。独立设置 LLM_VL_MODEL 可让文本和识图
# 使用不同模型；qwen-vl-plus 免费额度耗尽时可改用 qwen-vl-max。
LLM_MODEL=qwen-vl-plus
LLM_VL_MODEL=qwen-vl-plus
# 工作流决策层：只做结构化 JSON 决策，使用纯文本模型，避免占用 VL 配额。
# 与自然语言层分开是刻意设计，不要为了"统一"而改成同一个模型。
LLM_DECISION_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=30

# ---- 备选：DeepSeek（同样是 OpenAI 兼容协议）----
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_VL_MODEL=deepseek-chat
# LLM_DECISION_MODEL=deepseek-chat

# ---- 手机号验证码 ----
# 默认不配置短信服务商：/auth/send-code 返回 smsDelivered=false 和 devCode，
# 仅用于开发/演示，不会伪装成真实短信。
# ZHIXUE_ENV=development
# SMS_PROVIDER=

# ---- 服务端口 ----
PORT=5000
