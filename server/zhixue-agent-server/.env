# 知学 Mate · 后端环境变量模板
#
# 复制为 .env 后填写真实 Key：Copy-Item .env.example .env
# .env 已在 .gitignore 中，绝不入库、绝不提交到比赛压缩包。

# ---- 通义千问 / DashScope ----
# 不填也能跑：聊天层自动降级为确定性规则，并在回复里明确标注"非大模型输出"，
# 不会伪装成真实 AI 结果。填上之后「错题拍照 → Qwen-VL 真实识别」链路立即生效。
DASHSCOPE_API_KEY=sk-ws-H.PIEYPXR.adW6.MEQCIGhU4gP-pv6qnp6E85TJ60WpoYBOCuyQ6Q9DMPLLz64TAiA6RgyuQYBAfQbR7JaSyj9cuTv6E_J-ql3jmVgrWCUurQ
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-vl-max
LLM_VL_MODEL=qwen-vl-max
LLM_DECISION_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=30

# ---- 备选：DeepSeek（同样是 OpenAI 兼容协议）----
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_VL_MODEL=deepseek-chat

# ---- 手机号验证码 ----
# 默认不配置短信服务商：/auth/send-code 返回 smsDelivered=false 和 devCode，
# 仅用于开发/演示，不会伪装成真实短信。
# ZHIXUE_ENV=development
# SMS_PROVIDER=

# ---- 服务端口 ----
PORT=5000
