# ---- Python ----
__pycache__/
*.py[cod]
.pytest-tmp/
.pytest_cache/
*.egg-info/
.venv/
venv/

# ---- 环境与密钥（绝不入库 / 绝不进交付 zip）----
.env
*.env
!.env.example

# ---- 联调运行态（首启自动重建，绝不入库）----
# evidence/ 是要归档的证据，不要忽略
# data/repository.json 是运行期状态（profiles/sessions），不是内容数据；
# data/question_bank.json 是题库内容，**必须入库**，别误伤。
server/zhixue-agent-server/data/repository.json
server/zhixue-agent-server/data/repository.json.tmp
server/zhixue-agent-server/chat/history.json

# ---- HarmonyOS / DevEco ----
oh_modules/
.hvigor/
.idea/
.cxx/
build/
# *.hap 通用规则是为了防止把「编译产物」误提交（entry/build 下每构建一次就变）。
# 但 deliverables/ 下那一份签名 HAP 是**有意的交付物** ——
# 竞赛规程「演示：应用赛题须提交实际可演示的文件」要求它存在，
# 所以下面用 `!` 单独放行。改动这一条前请先读 docs/29 与 deliverables/README-签名HAP.md。
*.hap
!deliverables/*.hap
*.har
local.properties

# ---- 编辑器 / 系统 ----
.vscode/settings.json
Thumbs.db
desktop.ini
~$*
*.log
